# ==========================================================================
# job-application-tracker configuration
# Copy this file to .env and fill in real values:  cp .env.example .env
# ==========================================================================

# --- Email source selection ------------------------------------------------
# "local" = read a Thunderbird local folder (mbox file)
# "imap"  = fetch from a live IMAP server
EMAIL_SOURCE=local

# --- Local folder source (used when EMAIL_SOURCE=local) --------------------
# Directory that contains the Thunderbird folder files (the ImapMail dir).
LOCAL_FOLDER_DIR=/Users/username/Library/Thunderbird/Profiles/abc123.default-release/ImapMail/imap.gmail-0.com
# Folder name inside that directory (the mbox file, no extension).
LOCAL_FOLDER_NAME=Applications

# --- IMAP source (used when EMAIL_SOURCE=imap) ------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER=you@gmail.com
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
IMAP_PASS=your-app-password
IMAP_FOLDER=Applications

# --- LLM (any OpenAI-compatible chat endpoint) ------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=300

# --- Output -----------------------------------------------------------------
CSV_PATH=data/applications.csv
CHECKPOINT_PATH=data/checkpoint.json

# --- Behavior ---------------------------------------------------------------
# Max characters of email body sent to the LLM.
MAX_BODY_CHARS=8000
# Retries per LLM call on transient errors (connection, rate limit, 5xx).
RETRY_ATTEMPTS=4
# Initial backoff between retries in seconds (doubles each retry).
RETRY_BACKOFF_SECONDS=2.0
